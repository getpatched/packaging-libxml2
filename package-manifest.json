{
  "schemaVersion": 3,
  "project": {
    "name": "GetPatched",
    "repository": "getpatched/packaging-libxml2",
    "description": "Declarative, target-specific maintenance recipe for the libxml2 source package."
  },
  "package": {
    "source": "libxml2",
    "description": "XML parsing library and command-line utilities.",
    "upstreamProject": "GNOME libxml2",
    "upstreamRepository": "https://gitlab.gnome.org/GNOME/libxml2",
    "copyrightFile": "LICENSES/SOURCE-COPYRIGHTS.md"
  },
  "targets": [
    {
      "id": "ubuntu-focal-amd64",
      "file": "targets/ubuntu/focal-amd64.json"
    },
    {
      "id": "debian-bookworm-amd64",
      "file": "targets/debian/bookworm-amd64.json"
    },
    {
      "id": "debian-trixie-amd64",
      "file": "targets/debian/trixie-amd64.json"
    }
  ],
  "patchMetadata": "patches/metadata.json",
  "regressionTests": {
    "fixturesDirectory": "tests/fixtures",
    "runner": "getpatched/platform:verification/regression.py"
  },
  "licensing": {
    "publicContributionsSpdx": "MIT",
    "publicContributionsLicenseFile": "LICENSE",
    "earlyBinaryLicenseId": "LicenseRef-GetPatched-Early-Binary-1.2",
    "earlyBinaryTermsFile": "LICENSES/GETPATCHED-EARLY-ACCESS-1.2.md",
    "upstreamCopyrightFile": "LICENSES/SOURCE-COPYRIGHTS.md",
    "fileLicenses": [
      {
        "path": "tests/fixtures/cve-2026-6653-harness.cc",
        "spdx": "BSD-3-Clause",
        "licenseFile": "LICENSES/CHROMIUM-BSD-3-CLAUSE.txt"
      },
      {
        "path": "patches/CVE-2026-6653-debian.patch",
        "spdx": "MIT"
      }
    ],
    "upstreamLicenses": "preserve"
  }
}
