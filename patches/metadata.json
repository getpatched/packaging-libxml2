      "cves": ["CVE-2026-6653"],
      "upstream": {
        "repository": "https://gitlab.gnome.org/GNOME/libxml2",
        "commit": "f19a95108a32b40eaa3b16b41d7a687896e61ce5",
        "url": "https://gitlab.gnome.org/GNOME/libxml2/-/commit/f19a95108a32b40eaa3b16b41d7a687896e61ce5",
        "additionalCommits": [
          {
            "commit": "e129c1d1a27abdeaab44f4d59eb0cb5052df7c6f",
            "url": "https://gitlab.gnome.org/GNOME/libxml2/-/commit/e129c1d1a27abdeaab44f4d59eb0cb5052df7c6f",
            "purpose": "Stops xmlSkipBlankChars after parser EOF so allocation-failure handling cannot loop indefinitely."
          }
        ]
      },
      "appliesTo": [
